{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpero.com/protocol/computer-observation.schema.json",
  "title": "ComputerObservationContract",
  "description": "Generated from protocol/computer-use.tsp. Do not edit.",
  "oneOf": [
    {
      "$ref": "#/$defs/ComputerCapabilities"
    },
    {
      "$ref": "#/$defs/ComputerTarget"
    },
    {
      "$ref": "#/$defs/ComputerObservation"
    }
  ],
  "$defs": {
    "ComputerActionKind": {
      "title": "ComputerActionKind",
      "type": "string",
      "enum": [
        "click",
        "type_text",
        "press_key",
        "scroll",
        "drag"
      ]
    },
    "ComputerActionSupport": {
      "title": "ComputerActionSupport",
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ComputerActionKind"
        },
        "delivery": {
          "$ref": "#/$defs/ComputerDelivery"
        },
        "addressing": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComputerAddressing"
          }
        }
      },
      "required": [
        "action",
        "delivery",
        "addressing"
      ],
      "additionalProperties": false,
      "description": "Supported addressing for an action/delivery pair; target-specific refusals remain possible."
    },
    "ComputerAddressing": {
      "title": "ComputerAddressing",
      "type": "string",
      "enum": [
        "element",
        "pixel"
      ]
    },
    "ComputerCapabilities": {
      "title": "ComputerCapabilities",
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "const": "pero.computer-use.v1"
        },
        "runtime_id": {
          "$ref": "#/$defs/ComputerRef"
        },
        "environment": {
          "$ref": "#/$defs/ComputerEnvironment"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComputerObservationKind"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComputerActionSupport"
          }
        }
      },
      "required": [
        "protocol",
        "runtime_id",
        "environment",
        "observations",
        "actions"
      ],
      "additionalProperties": false
    },
    "ComputerDelivery": {
      "title": "ComputerDelivery",
      "type": "string",
      "enum": [
        "background",
        "foreground"
      ]
    },
    "ComputerDimension": {
      "title": "ComputerDimension",
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "ComputerDisplay": {
      "title": "ComputerDisplay",
      "type": "string",
      "enum": [
        "native",
        "x11",
        "xwayland",
        "wayland",
        "unavailable"
      ]
    },
    "ComputerElement": {
      "title": "ComputerElement",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComputerRef"
        },
        "role": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComputerActionKind"
          }
        }
      },
      "required": [
        "id",
        "role",
        "label",
        "depth",
        "actions"
      ],
      "additionalProperties": false
    },
    "ComputerEnvironment": {
      "title": "ComputerEnvironment",
      "type": "object",
      "properties": {
        "platform": {
          "$ref": "#/$defs/ComputerPlatform"
        },
        "display": {
          "$ref": "#/$defs/ComputerDisplay"
        },
        "desktop": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "platform",
        "display"
      ],
      "additionalProperties": false
    },
    "ComputerObservation": {
      "title": "ComputerObservation",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComputerRef"
        },
        "target": {
          "$ref": "#/$defs/ComputerTargetRef"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComputerElement"
          }
        },
        "screenshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComputerScreenshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "target",
        "elements",
        "truncated"
      ],
      "additionalProperties": false
    },
    "ComputerObservationKind": {
      "title": "ComputerObservationKind",
      "type": "string",
      "enum": [
        "accessibility",
        "screenshot"
      ]
    },
    "ComputerPlatform": {
      "title": "ComputerPlatform",
      "type": "string",
      "enum": [
        "macos",
        "windows",
        "linux",
        "other"
      ]
    },
    "ComputerRef": {
      "title": "ComputerRef",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Host-issued references, never OS handles, paths, credentials or caller identities."
    },
    "ComputerScreenshot": {
      "title": "ComputerScreenshot",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComputerRef"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string",
              "const": "image/png"
            },
            {
              "type": "string",
              "const": "image/jpeg"
            }
          ]
        },
        "width": {
          "$ref": "#/$defs/ComputerDimension"
        },
        "height": {
          "$ref": "#/$defs/ComputerDimension"
        }
      },
      "required": [
        "id",
        "media_type",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "description": "The Host resolves this immutable image reference to bytes; no local path is exposed."
    },
    "ComputerTarget": {
      "title": "ComputerTarget",
      "type": "object",
      "properties": {
        "reference": {
          "$ref": "#/$defs/ComputerTargetRef"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "const": "window"
            },
            {
              "type": "string",
              "const": "desktop"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "application": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "reference",
        "kind",
        "title"
      ],
      "additionalProperties": false
    },
    "ComputerTargetRef": {
      "title": "ComputerTargetRef",
      "type": "object",
      "properties": {
        "runtime_id": {
          "$ref": "#/$defs/ComputerRef"
        },
        "target_id": {
          "$ref": "#/$defs/ComputerRef"
        }
      },
      "required": [
        "runtime_id",
        "target_id"
      ],
      "additionalProperties": false
    }
  }
}

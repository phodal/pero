{
  "schemaVersion": 1,
  "name": "lab",
  "version": "0.1.0",
  "displayName": "Lab",
  "description": "Design, simulate and independently evaluate liquid-handling experiments.",
  "contributes": {
    "panels": [{"id": "main", "title": "Lab", "entry": "dist/index.html"}],
    "writes": [{
      "name": "lab-step",
      "description": "Read a frozen experiment; propose typed liquid-handling steps with input_hash, reason and parent_id; validate, simulate via PyLabRobot Chatterbox, attach an explicitly synthetic fixture, evaluate, observe/compare history or cancel. Actions other than read/observe/compare/propose need trial_id. Proposal creates a new immutable candidate and consumes a bounded budget. No hardware, arbitrary scripts, imported measurement fabrication, acceptance, or policy edits. Execution completion is not verification PASS.",
      "path": "/api/agent-step",
      "schema": {
        "type": "object",
        "properties": {
          "action": {"type": "string", "enum": ["read", "propose", "validate", "simulate", "synthetic", "observe", "evaluate", "compare", "cancel"]},
          "experiment_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
          "trial_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
          "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "steps": {
            "type": "array", "minItems": 1, "maxItems": 64,
            "items": {
              "type": "object",
              "properties": {
                "action": {"type": "string", "enum": ["pick_up_tip", "aspirate", "dispense", "return_tip"]},
                "resource": {"type": "string", "pattern": "^[A-H]([1-9]|1[0-2])$"},
                "volume_ul": {"type": "number", "exclusiveMinimum": 0, "maximum": 360}
              },
              "required": ["action"], "additionalProperties": false
            }
          },
          "reason": {"type": "string", "minLength": 1, "maxLength": 500},
          "parent_id": {"type": ["string", "null"]}
        },
        "required": ["action", "experiment_id"], "additionalProperties": false
      }
    }]
  },
  "backend": {"type": "python", "entry": "backend/server.py", "dependencies": ["pylabrobot==0.2.1"]}
}

{
  "schemaVersion": 1,
  "name": "paper-agent",
  "version": "0.1.0",
  "displayName": "Paper Agent",
  "description": "论文阅读、证据核对与研究报告。",
  "permissions": {
    "host": [
      "agent"
    ]
  },
  "contributes": {
    "panels": [
      {
        "id": "main",
        "title": "Paper Agent",
        "entry": "dist/index.html"
      }
    ],
    "writes": [
      {
        "name": "import-paper",
        "description": "Save an explicitly supplied source snapshot in this App library. It does not fetch a URL, execute research or accept a scientific claim.",
        "path": "/api/papers/import",
        "schema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "sourceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "url": {
              "type": "string",
              "maxLength": 2000
            },
            "authors": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "string",
                "maxLength": 300
              }
            },
            "contentKind": {
              "type": "string",
              "enum": [
                "abstract",
                "report",
                "full-text"
              ]
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          },
          "required": [
            "title",
            "sourceId",
            "url",
            "authors",
            "contentKind",
            "content"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "research-step",
        "description": "Record a reading action in a frozen ResearchStudy: search, read PDF pages, note evidence or finalize a cited report. Recall retrieves previously observed evidence without consuming the step budget. It does not execute experiments or grant scientific acceptance. The context action reads the frozen selected-context file by line range without adding source evidence.",
        "path": "/api/studies/step",
        "schema": {
          "type": "object",
          "properties": {
            "studyId": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "action": {
              "type": "string",
              "enum": [
                "search",
                "read",
                "recall",
                "note",
                "finalize",
                "context"
              ]
            },
            "paperId": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "query": {
              "type": "string",
              "maxLength": 500
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "text": {
              "type": "string",
              "maxLength": 4000
            },
            "gaps": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "maxLength": 500
              }
            },
            "evidence": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "properties": {
                  "paperId": {
                    "type": "string"
                  },
                  "passageId": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string",
                    "maxLength": 4000
                  }
                },
                "required": [
                  "paperId",
                  "passageId",
                  "quote"
                ],
                "additionalProperties": false
              }
            },
            "report": {
              "type": "object"
            },
            "passageId": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "startLine": {
              "type": "integer",
              "minimum": 1
            },
            "endLine": {
              "type": "integer",
              "minimum": 1
            },
            "contextId": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            }
          },
          "required": [
            "studyId",
            "action"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "read-context",
        "description": "Read a saved UTF-8 selected-context file by its opaque contextId, in bounded character or line ranges. Does not execute code or add validated paper evidence.",
        "path": "/api/contexts/read",
        "schema": {
          "type": "object",
          "properties": {
            "contextId": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "startLine": {
              "type": "integer",
              "minimum": 1
            },
            "endLine": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "contextId"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  "backend": {
    "type": "python",
    "entry": "backend/server.py",
    "dependencies": ["pypdfium2==5.0.0", "Pillow==12.0.0"]
  }
}

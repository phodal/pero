{
  "schemaVersion": 1,
  "name": "control-lab",
  "version": "0.1.0",
  "displayName": "Control Lab",
  "description": "Design and independently verify controllers and active filters.",
  "contributes": {
    "panels": [
      {
        "id": "main",
        "title": "Control Lab",
        "entry": "dist/index.html"
      }
    ],
    "writes": [
      {
        "name": "experiment-step",
        "description": "Read a frozen experiment, evaluate its baseline, advance bounded search by one candidate, run batch search, lock a candidate, independently verify, cancel, or re-evaluate saved observations. Batch search fills remaining candidate slots. Backend owns numeric bounds and immutable policy; execution success never implies engineering PASS.",
        "path": "/api/agent-step",
        "schema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "read",
                "baseline",
                "search-next",
                "search",
                "cancel",
                "lock",
                "verify",
                "reevaluate"
              ]
            },
            "experimentId": {
              "type": "string",
              "maxLength": 100
            },
            "candidateId": {
              "type": "string",
              "maxLength": 100
            }
          },
          "required": [
            "action",
            "experimentId"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "propose-candidate",
        "description": "Propose bounded controller gains (kp, ki, kd) or active-filter components (r, c, gain), then evaluate on search scenarios. Consumes the frozen candidate budget. Cannot modify the specification, verification policy, or a locked candidate.",
        "path": "/api/agent-step",
        "schema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "propose"
              ]
            },
            "experimentId": {
              "type": "string",
              "maxLength": 100
            },
            "parameters": {
              "type": "object",
              "properties": {
                "kp": {
                  "type": "number"
                },
                "ki": {
                  "type": "number"
                },
                "kd": {
                  "type": "number"
                },
                "r": {
                  "type": "number"
                },
                "c": {
                  "type": "number"
                },
                "gain": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "action",
            "experimentId",
            "parameters"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "project-result",
        "description": "Project one saved candidate into a versioned conversation receipt. Read-only: it does not solve, lock, or change parameters. Call it after the approved propose, baseline, or search-next operation is idle. The receipt's status is unavailable, failed, unchecked, check_failed, inconclusive, or pass for these search scenarios only. A saved report is included only when a fresh check binds the current parameters; changing parameters leaves the old check in notApplicable and does not mark the new input passed. Cite the receipt citation. Do not copy its numbers into chart_render or table_render, and do not treat the receipt as device acceptance.",
        "path": "/api/agent-step",
        "schema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "project"
              ]
            },
            "experimentId": {
              "type": "string",
              "minLength": 32,
              "maxLength": 32
            },
            "candidateId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "action",
            "experimentId",
            "candidateId"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "create-experiment",
        "description": "Create a frozen PI controller specification from the saved Notebook parameters. Run it separately in Control Lab.",
        "path": "/api/canvas/create-experiment",
        "schema": {
          "type": "object",
          "properties": {
            "operationId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
            "inputs": {
              "type": "object",
              "properties": {
                "submissionId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
                "horizon": {"$ref": "#/$defs/parameter"},
                "samples": {"$ref": "#/$defs/parameter"}
              },
              "required": ["submissionId", "horizon", "samples"],
              "additionalProperties": false
            },
            "params": {"type": "object", "additionalProperties": false}
          },
          "required": ["operationId", "inputs", "params"],
          "additionalProperties": false,
          "$defs": {
            "parameter": {
              "type": "object",
              "properties": {
                "procedureId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
                "parameterId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
                "version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
                "value": {"type": "string", "minLength": 1, "maxLength": 128}
              },
              "required": ["procedureId", "parameterId", "version", "value"],
              "additionalProperties": false
            }
          }
        }
      }
    ],
    "canvases": [
      {
        "id": "notebook-experiment",
        "title": "PI controller experiment",
        "read": "/internal/canvas/experiment",
        "status": "/internal/canvas/status",
        "inputs": {
          "type": "object",
          "properties": {
            "submissionId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
            "horizon": {"$ref": "#/$defs/parameter"},
            "samples": {"$ref": "#/$defs/parameter"}
          },
          "required": ["submissionId", "horizon", "samples"],
          "additionalProperties": false,
          "$defs": {
            "parameter": {
              "type": "object",
              "properties": {
                "procedureId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
                "parameterId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
                "version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
                "value": {"type": "string", "minLength": 1, "maxLength": 128}
              },
              "required": ["procedureId", "parameterId", "version", "value"],
              "additionalProperties": false
            }
          }
        },
        "actions": ["create-experiment"]
      }
    ]
  },
  "backend": {
    "type": "python",
    "entry": "backend/server.py",
    "python": "3.12",
    "dependencies": ["control==0.10.2", "numpy==2.2.6", "scipy==1.18.1", "matplotlib==3.10.3"]
  }
}

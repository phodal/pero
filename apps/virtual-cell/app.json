{
  "schemaVersion": 1,
  "name": "virtual-cell",
  "version": "0.2.0",
  "displayName": "Virtual Cell",
  "description": "单细胞图谱与扰动分析、反应模拟和三维体素浏览。",
  "contributes": {
    "panels": [
      {
        "id": "main",
        "title": "Virtual Cell",
        "entry": "dist/index.html"
      }
    ],
    "writes": [
      {
        "name": "import-inputs",
        "description": "Import explicit Virtual Cell JSON input documents; the backend validates scientific input contracts. This does not run or accept an experiment.",
        "path": "/api/inputs",
        "schema": {
          "type": "object",
          "properties": {
            "documents": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "string",
                "maxLength": 65536
              }
            }
          },
          "required": [
            "documents"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  "backend": {
    "type": "python",
    "entry": "backend/server.py"
  }
}

{
  "schemaVersion": 1,
  "name": "scientific-viewer",
  "version": "0.4.0",
  "displayName": "Scientific Viewer",
  "description": "Preview scientific files and run notebooks with shared Agent Python/R sessions or a separate Python kernel.",
  "permissions": {
    "host": [
      "agent"
    ]
  },
  "contributes": {
    "panels": [
      {
        "id": "viewer",
        "title": "Scientific Viewer",
        "entry": "dist/index.html"
      }
    ]
  },
  "backend": {
    "type": "python",
    "entry": "backend/server.py",
    "dependencies": [
      "rdkit==2026.9.1",
      "numpy==2.2.6",
      "Pillow==12.0.0",
      "jupyter-client==8.10.0",
      "ipykernel==7.4.0"
    ]
  }
}

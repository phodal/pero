{
  "name": "@pero/app-notebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "node ../../scripts/build/source-parsers.mjs",
    "build": "node ../../scripts/build/apps.mjs --app notebook",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "npm run test:editor && PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s test -v",
    "test:browser": "node --test test/notebook-browser.mjs test/content-editing-browser.mjs test/source-diagnostics-browser.mjs test/scientific-block-browser.mjs test/myst-document-browser.mjs test/myst-project-browser.mjs test/ipynb-browser.mjs",
    "test:editor": "node --test --test-concurrency=4 test/*.test.ts"
  },
  "dependencies": {
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-task-item": "3.33.0",
    "@tiptap/extension-task-list": "3.33.0",
    "@tiptap/extension-unique-id": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@tiptap/extension-code-block": "3.33.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}

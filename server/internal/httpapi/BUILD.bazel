load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "httpapi",
    srcs = [
        "clients.go",
        "artifacts.go",
        "artifact_collector.go",
        "runtime_channel.go",
        "contributions.go",
        "github.go",
        "routes.go",
        "sandbox.go",
        "worker.go",
        "worker_devices.go",
    ],
    importpath = "github.com/phodal/pero/server/internal/httpapi",
    visibility = ["//server:__subpackages__"],
    deps = [
        "//server/internal/github",
        "//server/internal/store",
        "//server/internal/sandbox",
        "//server/internal/runtimebinding",
        "//server/internal/artifacts",
        "//server/internal/runtimeauth",
        "//server/internal/runtimechannel",
        "//server/internal/environments/model",
        "//server/internal/runtimegateway",
        "@com_github_jackc_pgx_v5//pgconn",
    ],
)

go_test(
    name = "httpapi_test",
    srcs = [
        "clients_test.go",
        "artifacts_test.go",
        "isolated_process_test.go",
        "isolated_live_test.go",
        "worker_devices_test.go",
        "desktop_github_test.go",
        "desktop_connector_test.go",
        "github_test.go",
        "integration_test.go",
    ],
    env = {"PERO_REQUIRE_TEST_DATABASE": "1"},
    env_inherit = ["PERO_TEST_DATABASE_URL", "PERO_ISOLATED_PROCESS_E2E", "PERO_SANDBOX_WORKER_BINARY", "PERO_REMOTE_BRIDGE_BINARY", "PERO_REMOTE_CONNECT_BINARY"],
    tags = [
        "external",  # Always rerun against the current database, including locally.
        "local",
        "manual",
        "no-cache",
        "no-remote",
    ],
    visibility = ["//server:__pkg__"],
    deps = [
        ":httpapi",
        "//server/internal/github",
        "//server/internal/store",
        "//server/internal/sandbox",
        "//server/internal/runtimebinding",
        "//server/internal/artifacts",
        "//server/internal/runtimeauth",
        "//server/internal/runtimechannel",
        "//server/internal/environments/model",
        "//server/internal/runtimegateway",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

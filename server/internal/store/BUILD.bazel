load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "store",
    srcs = [
        "clients.go",
        "contribution.go",
        "contributions.go",
        "community.go",
        "desktop_auth.go",
        "execution.go",
        "runtime.go",
        "github.go",
        "models.go",
        "roadmap.go",
        "roadmap_list.go",
        "store.go",
        "worker_devices.go",
        "tasks.go",
    ],
    importpath = "github.com/phodal/pero/server/internal/store",
    visibility = ["//server:__subpackages__"],
    deps = [
        "//server/migrations",
        "//server/internal/runtimebinding",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

go_test(
    name = "store_test",
    srcs = [
        "clients_test.go",
        "worker_devices_test.go",
        "contribution_test.go",
        "contributions_test.go",
        "desktop_auth_test.go",
        "community_test.go",
        "github_test.go",
        "integration_test.go",
        "runtime_test.go",
        "roadmap_test.go",
    ],
    embed = [":store"],
    env = {"PERO_REQUIRE_TEST_DATABASE": "1"},
    env_inherit = ["PERO_TEST_DATABASE_URL"],
    tags = [
        "external",  # Always rerun against the current database, including locally.
        "local",
        "manual",
        "no-cache",
        "no-remote",
    ],
    visibility = ["//server:__pkg__"],
    deps = [
        "//server/internal/runtimebinding",
        "//server/internal/environments/model",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

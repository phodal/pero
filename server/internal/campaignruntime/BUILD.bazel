load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "campaignruntime",
    srcs = ["activities.go", "review.go", "temporal.go", "workflow.go"],
    importpath = "github.com/phodal/pero/server/internal/campaignruntime",
    visibility = ["//server:__subpackages__"],
    deps = [
        "//server/internal/campaign",
        "@io_temporal_go_api//enums/v1:enums",
        "@io_temporal_go_api//serviceerror",
        "@io_temporal_go_sdk//activity",
        "@io_temporal_go_sdk//client",
        "@io_temporal_go_sdk//temporal",
        "@io_temporal_go_sdk//worker",
        "@io_temporal_go_sdk//workflow",
    ],
)

go_test(
    name = "campaignruntime_test",
    srcs = ["replay_test.go", "workflow_test.go"],
    embed = [":campaignruntime"],
    embedsrcs = ["testdata/cancel-in-flight-v1.json", "testdata/reviewed-pybamm-v2.json"],
    env_inherit = ["PERO_TEST_REVIEW_HISTORY"],
    deps = [
        "//server/internal/campaign",
        "@io_temporal_go_api//history/v1:history",
        "@io_temporal_go_sdk//activity",
        "@io_temporal_go_sdk//testsuite",
        "@io_temporal_go_sdk//worker",
        "@io_temporal_go_sdk//workflow",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)

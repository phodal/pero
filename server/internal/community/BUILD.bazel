load("@rules_go//go:def.bzl", "go_library", "go_test")

exports_files(["assets/theme.generated.css"])

go_library(
    name = "community",
    srcs = [
        "http.go",
        "desktop.go",
        "oauth.go",
    ],
    embedsrcs = [
        "assets/community.css",
        "assets/community.js",
        "assets/theme.generated.css",
        "templates/pages.html",
    ],
    importpath = "github.com/phodal/pero/server/internal/community",
    visibility = ["//server:__subpackages__"],
    deps = ["//server/internal/store"],
)

go_test(
    name = "community_test",
    srcs = ["http_test.go", "desktop_test.go"],
    embed = [":community"],
    env = {"PERO_REQUIRE_TEST_DATABASE": "1"},
    env_inherit = ["PERO_TEST_DATABASE_URL"],
    tags = [
        "external",  # Always exercise current database state, including locally.
        "local",
        "manual",
        "no-cache",
        "no-remote",
    ],
    visibility = ["//server:__pkg__"],
    deps = [
        "//server/internal/httpapi",
        "//server/internal/store",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

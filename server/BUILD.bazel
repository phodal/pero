# gazelle:prefix github.com/phodal/pero/server

exports_files([
    "go.mod",
    "go.sum",
])

# Real PostgreSQL acceptance is opt-in and never satisfied by a skipped test.
test_suite(
    name = "postgres_integration",
    tags = ["manual"],
    tests = [
        "//server/internal/community:community_test",
        "//server/internal/github:github_test",
        "//server/internal/httpapi:httpapi_test",
        "//server/internal/store:store_test",
        "//server/internal/sandbox:sandbox_test",
    ],
    visibility = ["//visibility:public"],
)

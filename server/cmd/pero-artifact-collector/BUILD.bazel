load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "collector_lib",
    srcs = ["main.go"],
    importpath = "github.com/phodal/pero/server/cmd/pero-artifact-collector",
    visibility = ["//visibility:private"],
    deps = ["//server/internal/artifacts", "//server/internal/artifacts/collector"],
)

go_binary(
    name = "pero-artifact-collector",
    embed = [":collector_lib"],
    visibility = ["//visibility:public"],
)

go_test(name = "collector_test", srcs = ["main_test.go"], embed = [":collector_lib"], deps = ["//server/internal/artifacts"])

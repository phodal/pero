{
  "manifest_version": 3,
  "name": "Pero Browser Use",
  "version": "0.1.0",
  "minimum_chrome_version": "125",
  "description": "Connect a Chrome tab you approve to the selected conversation in Pero.",
  "key": "",
  "permissions": [
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Pero Browser Use",
    "default_popup": "relay.html"
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*;"
  }
}

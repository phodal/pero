     /// Replace text in range in silent.
     ///
     /// This will not trigger any UI interaction, such as auto-completion.
+    /// Apply a canonical document edit to another view. No user history or input events are generated.
+    /// The caller restores this view's transformed reading state after the mutation.
+    pub fn apply_external_edit(&mut self,range:Range<usize>,inserted:&str,window:&mut Window,cx:&mut Context<Self>) {
+        let ignoring=self.undo_manager.is_ignoring();let events=self.emit_events;
+        self.undo_manager.set_ignoring(true);self.emit_events=false;
+        self.with_edits_allowed(|this|this.replace_text_in_ranges(&[(range,inserted.to_owned())],window,cx));
+        self.undo_manager.set_ignoring(ignoring);self.emit_events=events;
+    }
+
+    /// Record an edit from another view in the canonical document's undo history.
+    pub fn record_external_edit(&mut self,range:Range<usize>,inserted:&str,window:&mut Window,cx:&mut Context<Self>) {
+        let events=self.emit_events;self.emit_events=false;
+        self.with_edits_allowed(|this|this.replace_text_in_ranges(&[(range,inserted.to_owned())],window,cx));
+        self.emit_events=events;
+    }
+
+    /// Route all views' undo/redo through the canonical document owner.
+    pub fn replay_document_history(&mut self,undo:bool,window:&mut Window,cx:&mut Context<Self>) {
+        self.replay_history(undo,window,cx);
+    }
+
+    pub fn set_external_transaction(&mut self,begin:bool) {
+        if begin {self.undo_manager.begin_transaction();} else {self.undo_manager.commit_transaction();}
+    }
+    fn emit_edit_transaction(&self,begin:bool,cx:&mut Context<Self>) {
+        if self.emit_events && self.is_multi_line() {cx.emit(InputEvent::EditTransaction {begin});}
+    }
+
+    fn emit_source_edit(&self,old_text:&Rope,range:&Range<usize>,new_text:&str,cx:&mut Context<Self>) {
+        if !self.emit_events || !self.is_multi_line() || old_text.slice(range.clone()).bytes().eq(new_text.bytes()) {return;}
+        let start=old_text.offset_to_point(range.start);let end=old_text.offset_to_point(range.end);
+        cx.emit(InputEvent::Edit {
+            old:range.clone(),inserted:new_text.to_owned(),
+            old_lines:(start.row+usize::from(start.column>0))..(end.row+usize::from(end.column>0)),
+            new_line_count:new_text.bytes().filter(|byte|*byte==b'\n').count(),
+        });
+    }

+    /// Apply a canonical document edit to another view. No user history or input events are generated.
+    /// The caller restores this view's transformed reading state after the mutation.
+    pub fn apply_external_edit(&mut self,range:Range<usize>,inserted:&str,window:&mut Window,cx:&mut Context<Self>) {
+        let ignoring=self.undo_manager.is_ignoring();let events=self.emit_events;

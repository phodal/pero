+// Composition can start after keydown or end before keyup. In either case
+// 229 still identifies a key owned by the browser's IME. Its default action
+// must proceed without dispatching application bindings or inserting text.
+fn is_ime_key(is_composing: bool, event: &web_sys::KeyboardEvent) -> bool {
+    is_composing || event.is_composing() || event.key_code() == 229
+}

{
  "name": "openpero",
  "private": true,
  "type": "module",
  "workspaces": [
    "desktop",
    "web"
  ],
  "scripts": {
    "dev": "npm run build && npm run start --workspace @pero/desktop",
    "dev:web": "npm run dev --workspace @pero/web",
    "dev:apps": "npm run build && node scripts/dev/apps.mjs",
    "dev:paper": "npm run build && node scripts/dev/apps.mjs --app paper-agent",
    "dev:native": "node scripts/dev/native.mjs",
    "build": "npm run build:apps && npm run build:wasm && npm run build:host && npm run build:worker && npm run build:web && npm run build:desktop",
    "build:apps": "node scripts/build/apps.mjs",
    "build:wasm": "node scripts/build/wasm.mjs",
    "build:host": "node scripts/cargo.mjs build -p pero-host",
    "build:worker": "node scripts/cargo.mjs build -p pero-worker",
    "build:web": "npm run build --workspace @pero/web",
    "build:macos-dev": "node scripts/build/macos-dev-app.mjs",
    "build:macos-native": "node scripts/cargo.mjs build --release --locked -p pero-host -p pero-worker && node scripts/cargo.mjs +nightly-2026-10-28 build --release --locked -p pero-ui --features native --bin pero-native && node scripts/build/native-preview.mjs",
    "package:desktop": "node scripts/build/desktop-package.mjs",
    "package:macos": "npm run build:apps && PERO_BUILD_RELEASE=1 node scripts/build/wasm.mjs && node scripts/cargo.mjs build --release --locked -p pero-host -p pero-worker && npm run build:web && npm run build:desktop && node scripts/build/macos-package.mjs",
    "build:desktop": "node scripts/build/desktop.mjs",
    "check": "tsc --noEmit && node scripts/codegen/theme.mjs --check && node scripts/check/locales.mjs && node scripts/codegen/contracts.mjs --check && node scripts/generate-icons.mjs --check",
    "gen:icons": "node scripts/generate-icons.mjs",
    "test:workspace": "node tests/e2e/workspace.mjs",
    "gen:theme": "node scripts/codegen/theme.mjs",
    "gen:contracts": "node scripts/codegen/contracts.mjs",
    "gen:architecture": "node scripts/codegen/architecture.mjs",
    "gen:overview": "node scripts/codegen/overview.mjs",
    "test": "node scripts/cargo.mjs test -p pero-contracts -p pero-runtime -p pero-host -p pero-chat-ui -p pero-chat-web -p pero-ui -p pero-worker",
    "test:contracts": "npm run build:host && node tests/contracts/host.mjs",
    "test:apps": "node tests/e2e/apps.mjs",
    "test:paper": "node tests/e2e/paper-agent.mjs",
    "test:apps:contracts": "node tests/contracts/apps.mjs",
    "test:local-execution": "node tests/e2e/local-execution.mjs",
    "test:composer": "node tests/e2e/composer.mjs",
    "test:ime": "node tests/e2e/ime.mjs",
    "test:e2e": "node tests/e2e/desktop.mjs",
    "test:e2e:real": "node tests/e2e/real-session.mjs",
    "test:remote": "node tests/e2e/remote.mjs",
    "test:github": "cd server && PERO_DESKTOP_E2E=1 go test -count=1 -run '^TestDesktopGitHub' ./internal/httpapi -v",
    "test:i18n": "node tests/e2e/i18n.mjs",
    "test:community": "node tests/e2e/community.mjs",
    "test:connector": "cd server && PERO_DESKTOP_E2E=1 go test -count=1 -run '^TestDesktopConnectorSources$' ./internal/httpapi -v",
    "test:connector:live": "cd server && PERO_DESKTOP_E2E=1 PERO_CONNECTOR_LIVE=1 go test -count=1 -run '^TestDesktopConnectorSources$' ./internal/httpapi -v",
    "test:desktop-login": "node tests/e2e/desktop-login.mjs",
    "test:contribution": "node tests/e2e/contribution.mjs",
    "test:remote-settings": "node tests/e2e/remote-settings.mjs",
    "test:deployment": "node tests/e2e/deployment.mjs",
    "build:product": "node scripts/build/product.mjs",
    "test:product": "node --test packages/product/*.test.ts scripts/build/app-bundle.test.mjs scripts/build/workbench-payload.test.mjs",
    "test:product:e2e": "node tests/e2e/product.mjs",
    "test:product:chat": "node tests/e2e/product-chat.mjs",
    "test:sidebar": "node tests/e2e/sidebar.mjs",
    "test:local-roadmap": "node tests/e2e/local-roadmap.mjs",
    "test:app-use:unit": "node --test desktop/src/main/app-use.test.ts desktop/src/main/app-context.test.ts && node --disallow-code-generation-from-strings --test packages/app-sdk/src/app-use.test.ts",
    "test:app-use:real": "PERO_APP_USE_REAL_AGENT=1 node tests/e2e/app-use-real.mjs",
    "test:app-use:bridge": "node tests/e2e/app-use-bridge.mjs",
    "test:app-use": "npm run test:app-use:unit && npm run test:app-use:bridge && node tests/e2e/app-use-workbench.mjs && node tests/e2e/app-use.mjs"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.98.0",
    "@agentclientprotocol/codex-acp": "2.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@typespec/compiler": "1.17.0",
    "@typespec/json-schema": "1.17.0",
    "ajv": "8.20.0",
    "electron": "45.1.0",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "yaml": "2.8.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

{
  "name": "openpero",
  "private": true,
  "type": "module",
  "workspaces": [
    "desktop",
    "web"
  ],
  "scripts": {
    "dev": "npm run build && npm run start --workspace @pero/desktop",
    "dev:web": "npm run dev --workspace @pero/web",
    "build": "npm run build:wasm && npm run build:host && npm run build:web && npm run build:desktop",
    "build:wasm": "node scripts/build/wasm.mjs",
    "build:host": "node scripts/cargo.mjs build -p pero-host",
    "build:worker": "node scripts/cargo.mjs build -p pero-worker",
    "build:web": "npm run build --workspace @pero/web",
    "build:macos-dev": "node scripts/build/macos-dev-app.mjs",
    "build:desktop": "node scripts/build/desktop.mjs",
    "check": "tsc --noEmit && node scripts/codegen/theme.mjs --check && node scripts/check/locales.mjs && node scripts/codegen/contracts.mjs --check",
    "gen:theme": "node scripts/codegen/theme.mjs",
    "gen:contracts": "node scripts/codegen/contracts.mjs",
    "gen:architecture": "node scripts/codegen/architecture.mjs",
    "gen:overview": "node scripts/codegen/overview.mjs",
    "test": "node scripts/cargo.mjs test -p pero-contracts -p pero-runtime -p pero-host -p pero-ui -p pero-worker",
    "test:contracts": "npm run build:host && node tests/contracts/host.mjs",
    "test:e2e": "node tests/e2e/desktop.mjs",
    "test:e2e:real": "node tests/e2e/real-session.mjs",
    "test:remote": "node tests/e2e/remote.mjs",
    "test:github": "cd server && PERO_DESKTOP_E2E=1 go test -count=1 -run '^TestDesktopGitHub' ./internal/httpapi -v",
    "test:i18n": "node tests/e2e/i18n.mjs",
    "test:community": "node tests/e2e/community.mjs",
    "test:connector": "cd server && PERO_DESKTOP_E2E=1 go test -count=1 -run '^TestDesktopConnectorSources$' ./internal/httpapi -v",
    "test:connector:live": "cd server && PERO_DESKTOP_E2E=1 PERO_CONNECTOR_LIVE=1 go test -count=1 -run '^TestDesktopConnectorSources$' ./internal/httpapi -v",
    "test:desktop-login": "node tests/e2e/desktop-login.mjs",
    "test:remote-settings": "node tests/e2e/remote-settings.mjs",
    "test:deployment": "node tests/e2e/deployment.mjs"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.98.0",
    "@agentclientprotocol/codex-acp": "2.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@typespec/compiler": "1.17.0",
    "@typespec/json-schema": "1.17.0",
    "ajv": "8.20.0",
    "electron": "45.1.0",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "yaml": "2.8.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "media",
    srcs = [
        "attachment.go",
        "file_attachment.go",
        "file_projection.go",
        "image_access.go",
        "image_codec_process_unix.go",
        "image_codec_process_windows.go",
        "image_facts.go",
        "image_normalization.go",
        "image_projection.go",
        "official_image_codec.go",
        "request_image.go",
        "tool_image.go",
    ],
    embedsrcs = ["official_image_codec.mjs"],
    importpath = "github.com/phodal/pero/harness/go/media",
    visibility = ["//visibility:public"],
    deps = [
        "//model",
        "@org_golang_x_image//draw",
        "@org_golang_x_image//webp",
    ],
)

go_test(
    name = "media_test",
    srcs = [
        "file_attachment_cleanup_test.go",
        "file_attachment_test.go",
        "image_codec_process_linux_test.go",
        "image_normalization_test.go",
        "image_projection_test.go",
        "request_image_test.go",
        "test_helpers_test.go",
    ],
    embed = [":media"],
    deps = [
        "//model",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

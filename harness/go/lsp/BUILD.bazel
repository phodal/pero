load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "lsp",
    srcs = [
        "after_edit.go",
        "observed_files.go",
        "client.go",
        "config.go",
        "connection.go",
        "diagnostics.go",
        "process_unix.go",
        "process_unsupported.go",
        "results.go",
        "registration.go",
        "tool.go",
    ],
    importpath = "github.com/phodal/pero/harness/go/lsp",
    visibility = ["//visibility:public"],
    deps = [
        "//fstools",
        "//harness",
        "//nativetools",
        "//runtime",
    ],
)

go_test(
    name = "lsp_test",
    srcs = [
        "after_edit_test.go",
        "client_test.go",
        "diagnostics_client_test.go",
        "diagnostics_test.go",
        "protocol_test.go",
        "registration_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":lsp"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//harness",
            "//nativetools",
            "//runtime",
        ],
        "@rules_go//go/platform:darwin": [
            "//harness",
            "//nativetools",
            "//runtime",
        ],
        "@rules_go//go/platform:ios": [
            "//harness",
            "//nativetools",
            "//runtime",
        ],
        "@rules_go//go/platform:linux": [
            "//harness",
            "//nativetools",
            "//runtime",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "test_server",
    testonly = True,
    srcs = ["testdata/server.py"],
    visibility = ["//cmd/pero-agent-acp:__pkg__"],
)

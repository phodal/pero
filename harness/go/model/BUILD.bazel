load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "model",
    srcs = [
        "catalog_budget.go",
        "catalog_page.go",
        "clone.go",
        "content_attachment_extensions.go",
        "content_extensions.go",
        "content_strings.go",
        "file_content.go",
        "image_text.go",
        "session_event.go",
        "token_estimate.go",
        "tool_updates.go",
        "types.go",
    ],

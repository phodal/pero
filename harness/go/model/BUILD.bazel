go_test(
    name = "model_test",
    srcs = [
        "catalog_budget_test.go",
        "content_attachment_extensions_test.go",
        "content_extensions_test.go",
        "content_strings_test.go",
        "dependencies_test.go",
        "product_boundary_test.go",
        "session_event_test.go",
        "system_token_estimate_test.go",
        "token_estimate_test.go",
        "tool_updates_test.go",
    ],
    # Declare all production sources, including future additions, as fixtures.
    data = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ) + ["SOURCE.json"],  # keep
    embed = [":model"],
)
